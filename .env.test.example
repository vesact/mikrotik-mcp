# Integration test device configuration
# Copy to .env.test and fill in your device details
# Usage: source .env.test && npm run test:device

# Device 1 (physical MikroTik)
TEST_DEVICE_1_HOST=192.0.2.1
TEST_DEVICE_1_USER=admin
TEST_DEVICE_1_PASS=yourpassword
TEST_DEVICE_1_TYPE=physical
TEST_DEVICE_1_PORT=80
TEST_DEVICE_1_SCHEME=http

# Device 2 (CHR virtual)
# TEST_DEVICE_2_HOST=192.0.2.2
# TEST_DEVICE_2_USER=admin
# TEST_DEVICE_2_PASS=yourpassword
# TEST_DEVICE_2_TYPE=chr
# TEST_DEVICE_2_PORT=80
# TEST_DEVICE_2_SCHEME=http

# Device 3 (physical)
# TEST_DEVICE_3_HOST=192.0.2.3
# TEST_DEVICE_3_USER=admin
# TEST_DEVICE_3_PASS=yourpassword
# TEST_DEVICE_3_TYPE=physical
# TEST_DEVICE_3_PORT=80
# TEST_DEVICE_3_SCHEME=http

# Device 4 (CHR virtual)
# TEST_DEVICE_4_HOST=192.0.2.4
# TEST_DEVICE_4_USER=admin
# TEST_DEVICE_4_PASS=yourpassword
# TEST_DEVICE_4_TYPE=chr
# TEST_DEVICE_4_PORT=80
# TEST_DEVICE_4_SCHEME=http

# Optional: filter tests by tag
# TEST_TAGS=physical,single

# Optional: request timeout (ms)
# TEST_TIMEOUT_MS=15000
