# Credential source: keepass (default), env or file.
# Inferred from the variables set below; set it only if several sources are configured.
# CREDENTIAL_PROVIDER=keepass

# KeePass vault configuration
# Master password for the KeePass .kdbx vault (selects the keepass provider)
KEEPASS_PASSWORD=

# Optional: path to the KeePass vault file inside the container (default: /config/keepass.kdbx)
KEEPASS_PATH=/config/keepass.kdbx

# Optional: KeePass group to enumerate MikroTik devices from (default: mikrotik)
KEEPASS_GROUP=mikrotik

# env provider (read-only; setup-new-device is withheld)
# Single device: DEVICE_USER defaults to admin, DEVICE_ID to the host.
# DEVICE_HOST=192.0.2.1
# DEVICE_PASSWORD=
# DEVICE_USER=admin
# DEVICE_ID=router-01
# Or several devices as a JSON array:
# DEVICES=[{"id":"router-01","host":"192.0.2.1","password":"..."}]

# file provider (read-only): path to a JSON array in the DEVICES format
# DEVICES_FILE=/config/devices.json

# RouterOS REST API connection settings
# Optional: REST API port on the target devices (default: 443)
ROUTEROS_REST_PORT=443

# Optional: URL scheme for REST API connections — 'https' or 'http' (default: https)
ROUTEROS_REST_SCHEME=https

# Optional: REST API request timeout in milliseconds (default: 10000)
# Falls back to SSH_TIMEOUT_MS if not set
ROUTEROS_TIMEOUT_MS=10000

# Optional: per-command SSH timeout in milliseconds (default: 10000)
# Used by ros-command tool (SSH fallback) and as fallback for ROUTEROS_TIMEOUT_MS
SSH_TIMEOUT_MS=10000

# Optional: target port for the www (HTTP API) service when bootstrapping a new device
# with setup-new-device. Unset or 80 leaves the port unchanged.
# ROUTEROS_SETUP_PORT=80

# MCP server settings
# Optional: MCP transport — 'stdio' for local use, 'http' for shared team server (default: http)
MCP_TRANSPORT=http

# Optional: HTTP/SSE listen port, used only when MCP_TRANSPORT=http (default: 8000)
MCP_HTTP_PORT=8000

# Optional: HTTP bind address (default: 0.0.0.0)
MCP_HOST=0.0.0.0

# Optional: DNS-rebinding protection for MCP_TRANSPORT=http.
# When either list is set, requests whose Host/Origin header is not on the
# allow-list are rejected. Leave both unset only on a trusted, isolated network:
# the HTTP endpoint has no authentication of its own (see SECURITY.md).
# MCP_ALLOWED_HOSTS=mcp.internal:8000,localhost:8000
# MCP_ALLOWED_ORIGINS=https://mcp.internal

# Optional: read-only mode (default: false)
# When set to 'true' (also accepts 1/yes/on), the server exposes ONLY read-only
# state-query tools. All write/execution tools (ros-command, setup-new-device)
# and active diagnostic tools (ping, traceroute, torch, bandwidth-test, etc.)
# are withheld. Use this for safe, monitoring-only agent access.
READ_ONLY=false
