{
  "name": "mikrotik-mcp",
  "version": "2.0.0",
  "description": "MCP server for managing MikroTik RouterOS devices \u2014 65 tools over the RouterOS REST API with SSH fallback, KeePass-backed credentials, multi-device fan-out, and a read-only mode.",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:device": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "biome check",
    "check:fix": "biome check --write",
    "ci": "biome ci"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vesact/mikrotik-mcp.git"
  },
  "keywords": [
    "mikrotik",
    "routeros",
    "mcp",
    "model-context-protocol",
    "network-automation",
    "keepass"
  ],
  "author": "Actemium Schweiz AG",
  "license": "Apache-2.0",
  "overrides": {
    "@xmldom/xmldom": "^0.8.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "argon2": "^0.45.1",
    "kdbxweb": "^2.1.1",
    "ssh2": "^1.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.19.0",
    "@types/ssh2": "^1.15.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
